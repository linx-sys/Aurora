<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- P2-5 SMTC：带版本 TFM 才引入 WinRT 投影（Microsoft.Windows.SDK.NET.dll）；
         SupportedOSPlatformVersion 维持运行基线（SMTC 在旧系统上运行时静默禁用） -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AuroraPlayer</AssemblyName>
    <RootNamespace>Aurora</RootNamespace>
    <StartupObject>Aurora.App</StartupObject>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <OutputPath>build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- ui.xaml 编译为 BAML（P3 完成：编译期校验 + 启动提速） -->
    <Page Include="src\ui.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\App.cs" />
    <Compile Include="src\AppInfo.cs" />
    <Compile Include="src\AnimatedStackPanel.cs" />
    <Compile Include="src\Assoc.cs" />
    <Compile Include="src\CoverArt.cs" />
    <Compile Include="src\Id3.cs" />
    <Compile Include="src\Lrc.cs" />
    <Compile Include="src\LyricsViewController.cs" />
    <Compile Include="src\MainWindow.cs" />
    <Compile Include="src\Model.cs" />
    <Compile Include="src\NetMatch.cs" />
    <Compile Include="src\NetMatchSettingsDialog.cs" />
    <Compile Include="src\ILyricsProvider.cs" />
    <Compile Include="src\IPlaybackService.cs" />
    <Compile Include="src\IAudioOutput.cs" />
    <Compile Include="src\WaveOutAudioOutput.cs" />
    <Compile Include="src\WasapiAudioOutput.cs" />
    <Compile Include="src\PlayerEngine.cs" />
    <Compile Include="src\TagReaderService.cs" />
    <Compile Include="src\Tags.cs" />
    <Compile Include="src\ThemeController.cs" />
    <Compile Include="src\ViewModelBase.cs" />
    <Compile Include="src\RelayCommand.cs" />
    <Compile Include="src\MainViewModel.cs" />
    <Compile Include="src\VorbisWaveReader.cs" />
    <Compile Include="src\OpusWaveReader.cs" />
    <Compile Include="src\PlaybackController.cs" />
    <Compile Include="src\PlaylistManager.cs" />
    <Compile Include="src\AudioDecoders.cs" />
    <Compile Include="src\GainFadeSampleProvider.cs" />
    <Compile Include="src\PlaylistViewController.cs" />
    <Compile Include="src\ILibraryStore.cs" />
    <Compile Include="src\LibraryDatabase.cs" />
    <Compile Include="src\Loudness.cs" />
    <Compile Include="src\Logger.cs" />
    <Compile Include="src\UpdateChecker.cs" />
    <Compile Include="src\LibraryImportController.cs" />
    <Compile Include="src\SingleInstanceServer.cs" />
    <Compile Include="src\SmTcController.cs" />
    <Compile Include="src\WindowChromeController.cs" />
    <Compile Include="src\UiUtil.cs" />
    <Compile Include="src\ToastController.cs" />
    <Compile Include="src\PlaybackTickController.cs" />
    <Compile Include="src\HotkeyController.cs" />
    <Compile Include="src\NetMatchViewController.cs" />
    <Compile Include="src\WindowMiscController.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- NAudio 2.2.1 (MIT) - 音频输出 + 真实频谱样本抓取；元包自动携带 Core/WinMM/Wasapi 子包 -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- 混音器/重采样/单声道转立体声在 Core 子包（显式引用，保证编译期可见） -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <!-- NVorbis 0.10.4 (MIT) - OGG 纯托管解码 -->
    <PackageReference Include="NVorbis" Version="0.10.4" />
    <!-- Microsoft.Data.Sqlite 10.0.12 (MIT) - 媒体库缓存（增量扫描指纹复用） -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Concentus 1.1.6 + Concentus.Oggfile 1.0.4 (MIT) - OPUS 纯托管解码。
         注意：作者未发布到 NuGet（api.nuget.org 上无此包），只能保留本地 DLL 引用；
         若日后上架 NuGet 可改为 PackageReference。版本与 lib/ 下 DLL 一致。 -->
    <Reference Include="Concentus">
      <HintPath>lib\Concentus.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Concentus.Oggfile">
      <HintPath>lib\Concentus.Oggfile.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
