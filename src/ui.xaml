<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    Background="{DynamicResource Bg}">

  <Grid.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0B0D12"/>
    <SolidColorBrush x:Key="Panel" Color="#10131B"/>
    <SolidColorBrush x:Key="Bar" Color="#CC0D1017"/>
    <SolidColorBrush x:Key="Field" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="FieldLine" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Hover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TrackBg" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="Card" Color="#F01B2030"/>
    <SolidColorBrush x:Key="Base" Color="#1A1F2B"/>
    <SolidColorBrush x:Key="Ph" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#E9EDF6"/>
    <SolidColorBrush x:Key="Dim" Color="#8A93A8"/>
    <SolidColorBrush x:Key="Dim2" Color="#5D6579"/>
    <SolidColorBrush x:Key="Accent" Color="#4CC9F0"/>
    <SolidColorBrush x:Key="Pink" Color="#F472B6"/>

    <LinearGradientBrush x:Key="Grad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#4CC9F0" Offset="0"/>
      <GradientStop Color="#7C5CFF" Offset="0.6"/>
      <GradientStop Color="#F472B6" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="KeyboardFocus" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Control">
            <Rectangle Margin="2" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeDashArray="2,1" RadiusX="4" RadiusY="4"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{DynamicResource Field}" CornerRadius="9" BorderBrush="{DynamicResource FieldLine}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TrackBg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 标题栏三连按钮（最小化/全屏/关闭）：宽扁贴合、无间距 -->
    <Style x:Key="CapBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 标题栏关闭按钮（悬停红色） -->
    <Style x:Key="CapCloseBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 播放列表项 -->
    <DataTemplate x:Key="ListTpl">
      <Border x:Name="RowBd" CornerRadius="8" Background="Transparent" ToolTip="{Binding FileName}">
        <Grid Height="56" Background="Transparent">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Clip>
              <RectangleGeometry Rect="0,0,40,40" RadiusX="6" RadiusY="6"/>
            </Border.Clip>
            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="TitleTb" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding SubText}" FontSize="11.5" Foreground="{DynamicResource Dim}"
                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Grid.Column="2" x:Name="BtnDel" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="Transparent" BorderThickness="0" Cursor="Hand" Tag="delete" Opacity="0.35"
                  ToolTip="从播放列表移除" FocusVisualStyle="{x:Null}">
            <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource Dim}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
          </Button>
          <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="11.5" Foreground="{DynamicResource Dim2}"
                     VerticalAlignment="Center" Margin="8,0,8,0"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
          <Setter TargetName="TitleTb" Property="Foreground" Value="{DynamicResource Accent}"/>
          <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource Field}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="BtnDel" Property="Opacity" Value="1"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="ListItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="4,1" Padding="2">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sel}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <SolidColorBrush x:Key="Sel" Color="#1F7C5CFF"/>
  </Grid.Resources>

  <!-- ===== 播放页（唯一界面） ===== -->
  <Grid x:Name="FullPlayer" Background="{DynamicResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="96"/>
    </Grid.RowDefinitions>

    <!-- 柔和光晕背景 -->
    <Ellipse HorizontalAlignment="Left" VerticalAlignment="Center" Width="520" Height="520"
             Margin="-120,0,0,40" Opacity="0.5" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#1A7C5CFF" Offset="0"/>
          <GradientStop Color="#007C5CFF" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse HorizontalAlignment="Right" VerticalAlignment="Top" Width="420" Height="420"
             Margin="0,-90,140,0" Opacity="0.5" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#124CC9F0" Offset="0"/>
          <GradientStop Color="#004CC9F0" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="9*"/>
        <ColumnDefinition Width="11*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- 左：唱机（黑胶 + 唱臂），严格 1:1 -->
      <Viewbox Grid.Column="0" Stretch="Uniform" MaxWidth="340" MaxHeight="340"
               Margin="40,16,16,40" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="400" Height="400">
          <!-- 胶盘 -->
          <Ellipse x:Name="VinylDisc" Width="322" Height="322" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#060606" Offset="0"/>
                <GradientStop Color="#161616" Offset="0.72"/>
                <GradientStop Color="#303030" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
              <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.28"/>
            </Ellipse.Effect>
          </Ellipse>
          <!-- 旋转层：胶纹 + 中央封面圆 + 中孔 -->
          <Grid x:Name="VinylSpin" Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
              <RotateTransform x:Name="VinylRotate" CenterX="200" CenterY="200"/>
            </Grid.RenderTransform>
            <!-- 胶纹环（5 道，透明度递减） -->
            <Ellipse Width="258" Height="258" Stroke="#16FFFFFF" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="240" Height="240" Stroke="#12FFFFFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="222" Height="222" Stroke="#0FFFFFFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="204" Height="204" Stroke="#0CFFFFFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="196" Height="196" Stroke="#10FFFFFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <!-- 盘面高光弧（随盘旋转，模拟黑胶反光） -->
            <Path Data="M272.5,74.4 A145,145 0 0 1 325.6,272.5" Stroke="#0CFFFFFF" StrokeThickness="14"/>
            <Path Data="M127.5,325.6 A145,145 0 0 1 59.9,237.5" Stroke="#08FFFFFF" StrokeThickness="10"/>
            <!-- 中央封面圆 -->
            <Ellipse Width="182" Height="182" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse x:Name="VinylCoverHost" Width="174" Height="174" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse.Fill>
                <ImageBrush x:Name="VinylCover" Stretch="UniformToFill"/>
              </Ellipse.Fill>
              <Ellipse.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
              </Ellipse.Effect>
            </Ellipse>
            <!-- 中孔白圈 + 中孔 -->
            <Ellipse Width="24" Height="24" Stroke="#40FFFFFF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="16" Height="16" Fill="{DynamicResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <!-- 唱臂（暂停时移出盘面） -->
          <Canvas Width="400" Height="400">
            <Canvas.RenderTransform>
              <RotateTransform x:Name="ArmRotate" CenterX="292" CenterY="58"/>
            </Canvas.RenderTransform>
            <Ellipse Canvas.Left="271" Canvas.Top="37" Width="42" Height="42" Fill="White"/>
            <Line X1="292" Y1="58" X2="226" Y2="226" Stroke="#E9EDF6" StrokeThickness="8" StrokeEndLineCap="Round"/>
            <Ellipse Canvas.Left="212" Canvas.Top="216" Width="26" Height="26" Fill="#F2F5FA"/>
          </Canvas>
        </Grid>
      </Viewbox>

      <!-- 右：歌名 + 居中歌词 -->
      <Grid Grid.Column="1" Margin="0,50,30,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
          <TextBlock x:Name="FpTitle" Text="{Binding Title, FallbackValue=未在播放}" FontSize="26" FontWeight="Bold"
                     Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
          <TextBlock x:Name="FpArtist" Text="{Binding Artist, FallbackValue=双击 MP3 文件、或将音乐直接拖进窗口}" FontSize="14"
                     Foreground="{DynamicResource Dim}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
          <Rectangle x:Name="FpTitleBar" Width="36" Height="2.5" RadiusX="1.25" RadiusY="1.25"
                     HorizontalAlignment="Center" Margin="0,12,0,0" Fill="#60A5FA" Opacity="0.7"/>
        </StackPanel>
        <ScrollViewer x:Name="FpLyricsScroll" Grid.Row="1" HorizontalAlignment="Stretch"
                      Margin="0,22,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <Grid MaxWidth="560" HorizontalAlignment="Center">
            <StackPanel x:Name="FpLyricsPanel" Margin="0,8,0,40"/>
          </Grid>
        </ScrollViewer>
      </Grid>

      <!-- 右：播放列表面板（点播放列表按钮切换显隐） -->
      <Border Grid.Column="2" x:Name="ListPanel" Width="400" Visibility="Collapsed"
              Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="10,8,10,6">
            <Grid>
              <TextBlock Text="播放列表" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                         VerticalAlignment="Center"/>
              <Button x:Name="BtnSort" Style="{StaticResource IconBtn}" ToolTip="排序方式：文件名"
                      AutomationProperties.Name="切换排序方式"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
                <Path Data="M4,5 L20,5 L20,6.6 L4,6.6 Z M6,10 L18,10 L18,11.6 L6,11.6 Z M8,15 L16,15 L16,16.6 L8,16.6 Z"
                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      Stretch="Uniform" Width="15" Height="15"/>
              </Button>
            </Grid>
            <TextBlock x:Name="ListCountTb" Text="共 0 首歌曲" FontSize="11" Foreground="{DynamicResource Dim2}"
                       Margin="0,2,0,0"/>
          </StackPanel>
          <Border Grid.Row="1" Margin="10,0,10,8" Background="{DynamicResource Field}"
                  BorderBrush="{DynamicResource FieldLine}" BorderThickness="1" CornerRadius="8">
            <Grid>
              <TextBlock x:Name="SearchHint" Text="搜索标题 / 歌手 / 专辑 / 文件名" FontSize="13"
                         Foreground="{DynamicResource Ph}" Margin="10,0" VerticalAlignment="Center"
                         IsHitTestVisible="False"/>
              <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="10,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       FontSize="13" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                       VerticalContentAlignment="Center"/>
            </Grid>
          </Border>
          <ListBox Grid.Row="2" x:Name="ListList" Background="Transparent" BorderThickness="0" ItemsSource="{Binding View}"
                   ItemTemplate="{StaticResource ListTpl}" ItemContainerStyle="{StaticResource ListItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== 底部控制条 ===== -->
    <Border Grid.Row="1" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="18,7,18,9">
        <Grid.RowDefinitions>
          <RowDefinition Height="24"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="46"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" x:Name="CurTime" Text="{Binding CurrentTimeText, FallbackValue=0:00}" FontSize="11" Foreground="{DynamicResource Dim}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Grid Grid.Column="1" x:Name="SeekHit" Background="Transparent" Cursor="Hand" VerticalAlignment="Center">
            <Border x:Name="SeekTrackBg" Height="4" CornerRadius="2" Background="{DynamicResource TrackBg}"/>
            <Border x:Name="SeekFill" Height="4" CornerRadius="2" HorizontalAlignment="Left" Width="0"
                    Background="{DynamicResource Grad}"/>
            <Ellipse x:Name="SeekThumb" Width="12" Height="12" Fill="{DynamicResource Grad}" Visibility="Hidden"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0">
              <Ellipse.Effect>
                <DropShadowEffect Color="#4CC9F0" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
              </Ellipse.Effect>
            </Ellipse>
          </Grid>
          <TextBlock Grid.Column="2" x:Name="DurTime" Text="{Binding TotalTimeText, FallbackValue=0:00}" FontSize="11" Foreground="{DynamicResource Dim}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="BtnMode" Style="{StaticResource IconBtn}" ToolTip="播放模式：列表循环" Margin="0,0,14,0" Command="{Binding ToggleModeCommand}"
                    AutomationProperties.Name="切换播放模式">
              <Grid>
                <Path x:Name="IcoRepeat" Data="M7,7 L17,7 17,10 21,6 17,2 17,5 5,5 5,11 7,11 Z M17,17 L7,17 7,14 3,18 7,22 7,19 19,19 19,13 17,13 Z"
                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      Stretch="Uniform" Width="17" Height="17"/>
                <Grid x:Name="IcoOne" Visibility="Collapsed">
                  <Path Data="M7,7 L17,7 17,10 21,6 17,2 17,5 5,5 5,11 7,11 Z M17,17 L7,17 7,14 3,18 7,22 7,19 19,19 19,13 17,13 Z"
                        Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                        Stretch="Uniform" Width="17" Height="17"/>
                  <TextBlock Text="1" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Grid>
                <Path x:Name="IcoShuffle" Data="M17,3 L21,7 17,11 17,8.5 14.9,8.5 13.8,8.5 13,9.3 11.7,10.6 13.1,12.3 13.8,13 14.9,13 17,13 17,10.5 21,14.5 17,18.5 17,16 14.9,16 13.2,16 12.1,15.1 10.7,13.4 9.3,15.1 8.2,16 6.5,16 5.5,16 2,16 2,14 5.5,14 6.6,14 7.4,13.2 8.8,11.5 7.4,9.8 6.6,9 5.5,9 2,9 2,7 5.5,7 6.5,7 8.2,7 9.3,7.9 10.7,9.6 12.1,7.9 13.2,7 14.9,7 17,7 Z"
                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      Stretch="Uniform" Width="17" Height="17" Visibility="Collapsed"/>
              </Grid>
            </Button>
            <Button x:Name="BtnPrev" Style="{StaticResource IconBtn}" ToolTip="上一首 (P)" Command="{Binding PrevCommand}" AutomationProperties.Name="上一首 (P)">
              <Path Data="M5,3 L7,3 7,17 5,17 Z M16,3 L16,17 7,10 Z"
                    Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                    Stretch="Uniform" Width="18" Height="18"/>
            </Button>
            <Button x:Name="BtnPlay" Width="52" Height="52" Margin="14,0" Cursor="Hand" FocusVisualStyle="{x:Null}" Command="{Binding TogglePlayCommand}"
                    ToolTip="播放/暂停（空格）" AutomationProperties.Name="播放或暂停（空格）">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Grid>
                    <Ellipse x:Name="Bg" Fill="{DynamicResource Grad}" StrokeThickness="0">
                      <Ellipse.Effect>
                        <DropShadowEffect Color="#4CC9F0" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/>
                      </Ellipse.Effect>
                    </Ellipse>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <Grid>
                <Path x:Name="IcoPlay" Data="M6,3 L17,10 6,17 Z" Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                <Path x:Name="IcoPause" Data="M4,2 L8,2 8,16 4,16 Z M10,2 L14,2 14,16 10,16 Z" Fill="White"
                      Stretch="Uniform" Width="20" Height="20" Visibility="Collapsed"/>
              </Grid>
            </Button>
            <Button x:Name="BtnNext" Style="{StaticResource IconBtn}" ToolTip="下一首 (N)" Command="{Binding NextCommand}" AutomationProperties.Name="下一首 (N)">
              <Path Data="M4,3 L6,3 6,17 4,17 Z M15,3 L15,17 6,10 Z"
                    Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                    Stretch="Uniform" Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <ScaleTransform ScaleX="-1"/>
                </Path.RenderTransform>
              </Path>
            </Button>
            <Button x:Name="BtnMute" Style="{StaticResource IconBtn}" ToolTip="音量" Margin="14,0,0,0"
                    AutomationProperties.Name="音量 / 静音 (M)">
              <Grid>
                <Path x:Name="IcoVol" Data="M2,7 L6,7 11,2 11,16 6,11 2,11 Z M13.5,9 A4.5,4.5 0 0,0 11,5 L11,13 A4.5,4.5 0 0,0 13.5,9 Z M12,0.2 L12,2.3 A8,8 0 0,1 12,17.7 L12,19.8 A10,10 0 0,0 12,0.2 Z"
                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      Stretch="Uniform" Width="16" Height="16"/>
                <!-- 静音：喇叭 + 叉 -->
                <Grid x:Name="IcoMuted" Visibility="Collapsed">
                  <Path Data="M2,7 L6,7 11,2 11,16 6,11 2,11 Z M13.2,5.6 L19.4,12.4 M19.4,5.6 L13.2,12.4"
                        Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                        StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Stretch="Uniform" Width="16" Height="16"/>
                </Grid>
              </Grid>
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="BtnNet" Style="{StaticResource IconBtn}" ToolTip="联网匹配设置（按格式开关 / 清除缓存）" Margin="0,0,8,0"
                    AutomationProperties.Name="联网匹配设置">
              <Path Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M2,12 L22,12 M12,2 C7.5,6.5 7.5,17.5 12,22 C16.5,17.5 16.5,6.5 12,2"
                    Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                    StrokeThickness="1.8" Stretch="Uniform" Width="16" Height="16"/>
            </Button>
            <Button x:Name="BtnTheme" Style="{StaticResource IconBtn}" ToolTip="切换浅色 / 深色模式" Margin="0,0,8,0" AutomationProperties.Name="切换深浅主题">
              <Grid>
                <Path x:Name="IcoMoon" Data="M12.3,2.5 A9,9 0 1,0 21.4,13.4 A7.2,7.2 0 0,1 12.3,2.5 Z"
                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      Stretch="Uniform" Width="16" Height="16"/>
                <Path x:Name="IcoSun" Data="M12,7 A5,5 0 1,0 12,17 A5,5 0 0,0 12,7 Z M11,1.5 L13,1.5 13,4.5 11,4.5 Z M11,19.5 L13,19.5 13,22.5 11,22.5 Z M1.5,11 L4.5,11 4.5,13 1.5,13 Z M19.5,11 L22.5,11 22.5,13 19.5,13 Z M4.1,5.5 L5.5,4.1 7.6,6.2 6.2,7.6 Z M16.4,17.8 L17.8,16.4 19.9,18.5 18.5,19.9 Z M18.5,4.1 L19.9,5.5 17.8,7.6 16.4,6.2 Z M2.1,18.5 L4.2,16.4 5.6,17.8 3.5,19.9 Z"
                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      Stretch="Uniform" Width="16" Height="16" Visibility="Collapsed"/>
              </Grid>
            </Button>
            <Button x:Name="BtnOpenFolder" Style="{StaticResource IconBtn}" ToolTip="打开音乐文件夹" Margin="0,0,8,0" AutomationProperties.Name="打开音乐文件夹">
              <Path Data="M10,4 L4,4 A2,2 0 0,0 2,6 L2,18 A2,2 0 0,0 4,20 L20,20 A2,2 0 0,0 22,18 L22,8 A2,2 0 0,0 20,6 L12,6 Z"
                    Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                    Stretch="Uniform" Width="16" Height="16"/>
            </Button>
            <Button x:Name="BtnList" Style="{StaticResource IconBtn}" ToolTip="播放列表" AutomationProperties.Name="播放列表面板">
              <Path Data="M4,5 L9,5 9,6.6 4,6.6 Z M11,5 L20,5 20,6.6 11,6.6 Z M4,10.2 L9,10.2 9,11.8 4,11.8 Z M11,10.2 L20,10.2 20,11.8 11,11.8 Z M4,15.4 L9,15.4 9,17 4,17 Z M11,15.4 L20,15.4 20,17 11,17 Z"
                    Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                    Stretch="Uniform" Width="16" Height="16"/>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- 音量弹出（点击音量图标） -->
    <Popup x:Name="VolPopup" PlacementTarget="{Binding ElementName=BtnMute}" Placement="Top" VerticalOffset="12"
           HorizontalOffset="-7" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="12" Padding="10,12,10,8">
        <StackPanel>
          <Grid Height="130" Width="26" HorizontalAlignment="Center">
            <Border Width="6" Height="130" CornerRadius="3" Background="{DynamicResource TrackBg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border x:Name="VolFillV" Width="6" Height="80" CornerRadius="3" Background="{DynamicResource Grad}"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
            <Ellipse x:Name="VolThumbV" Width="12" Height="12" Fill="White" VerticalAlignment="Bottom"
                     HorizontalAlignment="Center" Margin="0,0,0,74"/>
            <Grid x:Name="VolHitV" Background="Transparent" Cursor="Hand"/>
          </Grid>
          <TextBlock x:Name="VolLabelV" Text="80" FontSize="11" Foreground="{DynamicResource Dim}"
                     HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </Popup>

    <!-- 左上：品牌标识（不参与命中，不挡窗口拖动） -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="18,0,0,0" Height="56" IsHitTestVisible="False">
      <Ellipse Width="9" Height="9" VerticalAlignment="Center">
        <Ellipse.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4CC9F0" Offset="0"/>
            <GradientStop Color="#F472B6" Offset="1"/>
          </LinearGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <TextBlock Text="Aurora · 极光音乐" FontSize="12" Foreground="{DynamicResource Dim2}"
                 VerticalAlignment="Center" Margin="8,0,0,0"/>
    </StackPanel>

    <!-- 右上：最小化 / 全屏 / 关闭（Windows 标准三连） -->
    <StackPanel x:Name="CapBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button x:Name="BtnMin" Style="{StaticResource CapBtn}" ToolTip="最小化">
        <Path Data="M5,12 L19,12 19,13.6 5,13.6 Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
              Stretch="Uniform" Width="14" Height="14"/>
      </Button>
      <Button x:Name="BtnFull" Style="{StaticResource CapBtn}" ToolTip="全屏 / 还原">
        <Grid>
          <!-- 非全屏：最大化（单方框） -->
          <Path x:Name="IcoMax" Data="M4.5,4.5 L19.5,4.5 L19.5,19.5 L4.5,19.5 Z M6,6 L6,18 L18,18 L18,6 Z"
                Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                Stretch="Uniform" Width="14" Height="14"/>
          <!-- 全屏：还原（叠加双方框，线宽 1.5 与最大化图标一致） -->
          <Path x:Name="IcoRestore" Data="M4,4 L15,4 L15,5.5 L4,5.5 Z M4,4 L5.5,4 L5.5,15 L4,15 Z M13.5,4 L15,4 L15,9 L13.5,9 Z M4,13.5 L9,13.5 L9,15 L4,15 Z M9,9 L20,9 L20,20 L9,20 Z M10.5,10.5 L10.5,18.5 L18.5,18.5 L18.5,10.5 Z"
                Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                Stretch="Uniform" Width="14" Height="14" Visibility="Collapsed"/>
        </Grid>
      </Button>
      <Button x:Name="BtnClose" Style="{StaticResource CapCloseBtn}" ToolTip="关闭">
        <Path Data="M6.4,5 L12,10.6 17.6,5 19,6.4 13.4,12 19,17.6 17.6,19 12,13.4 6.4,19 5,17.6 10.6,12 5,6.4 Z"
              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
              Stretch="Uniform" Width="13" Height="13"/>
      </Button>
    </StackPanel>

    <!-- Toast 提示 -->
    <Border x:Name="ToastCard" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,118"
            Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
            BorderThickness="1" CornerRadius="10" Padding="16,9" MaxWidth="640" Visibility="Collapsed">
      <TextBlock x:Name="ToastTb" Text="" FontSize="12.5" Foreground="{DynamicResource Text}"
                 TextWrapping="Wrap" TextAlignment="Center"/>
    </Border>
  </Grid>
</Grid>
